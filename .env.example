# Neon connection string (Neon dashboard > Connection Details). Keep sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Elsevier API key (dev.elsevier.com). Never commit the real value.
SCOPUS_API_KEY=
# Optional: institutional token from Elsevier, needed when the sync runs outside the IPB network
SCOPUS_INSTTOKEN=
